<view class="idiom-page">
  <block wx:if="{{view === 'catalog'}}">
    <view class="c-head">
      <text class="c-eyebrow">IDIOM · 词汇挑战</text>
      <view class="c-title">成语填字</view>
      <view class="c-sub">顺着释义，把相交的四字成语补完整。</view>
    </view>

    <view class="daily-card">
      <view class="daily-copy">
        <text class="daily-name">每日一题</text>
        <text class="daily-note">同一天、同难度，大家拿到同一题</text>
      </view>
      <view class="daily-start" bindtap="openDaily">开始</view>
      <view class="daily-options">
        <view
          class="daily-option {{dailyDifficulty === item.value ? 'active' : ''}}"
          wx:for="{{dailyOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="switchDailyDifficulty"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="level-summary">
      <view class="level-summary-top">
        <text>闯关星级</text>
        <view><text class="summary-num">{{totalStars}}</text><text class="summary-den"> / {{maxStars}} ★</text></view>
      </view>
      <view class="c-track"><view style="width: {{maxStars ? totalStars / maxStars * 100 : 0}}%;"></view></view>
    </view>

    <view class="loading-line" wx:if="{{loading}}">正在读取成语关卡…</view>

    <view class="chapter-list" wx:else>
      <view class="chapter" wx:for="{{categories}}" wx:key="id" wx:for-item="category">
        <view class="chapter-head" data-id="{{category.id}}" bindtap="toggleCategory" hover-class="row-pressed">
          <view class="chapter-no">{{index + 1}}</view>
          <view class="chapter-main">
            <text class="chapter-name">{{category.name}}</text>
            <text class="chapter-desc">{{category.description}}</text>
          </view>
          <view class="chapter-side">
            <text class="chapter-count">{{category.completed_levels}} / {{category.total_levels}}</text>
            <text class="chapter-chev {{category.expanded ? 'open' : ''}}">⌄</text>
          </view>
        </view>

        <view class="level-map" wx:if="{{category.expanded}}">
          <view class="level-node-wrap" wx:for="{{category.levels}}" wx:key="id" wx:for-item="level">
            <view
              class="level-node {{level.unlocked ? '' : 'locked'}} {{level.stars ? 'done' : ''}} {{level.current ? 'current' : ''}}"
              data-id="{{level.id}}"
              data-unlocked="{{level.unlocked}}"
              bindtap="openLevel"
              hover-class="node-pressed"
            >
              <text class="node-no">{{level.order}}</text>
              <text class="node-star">{{level.unlocked ? (level.starText || '☆☆☆') : '锁'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="game-top">
      <view class="back-pill" bindtap="backToCatalog">‹ 关卡</view>
      <view class="difficulty-chip">{{puzzle.difficulty}}</view>
    </view>
    <view class="c-head game-head">
      <text class="c-eyebrow">IDIOM · {{puzzleMode === 'daily' ? '每日挑战' : '连续闯关'}}</text>
      <view class="c-title">{{puzzle.title}}</view>
      <view class="c-sub">点击格子，再从字库选择文字。</view>
    </view>

    <view class="status-strip">
      <view><text>用时</text><text>{{elapsedText}}</text></view>
      <view><text>错误</text><text>{{mistakes}}</text></view>
      <view><text>提示</text><text>{{hintsUsed}} / {{maxHints}}</text></view>
    </view>

    <view class="crossword-wrap">
      <view class="crossword-board size-{{puzzle.size}}">
        <button
          class="idiom-cell {{item.type === 'fixed' ? 'fixed' : ''}} {{item.selected ? 'selected' : ''}} {{item.invalid ? 'invalid' : ''}} {{item.activeEntry ? 'active-entry' : ''}}"
          wx:for="{{cells}}"
          wx:key="index"
          style="grid-row: {{item.gridRow}}; grid-column: {{item.gridColumn}};"
          data-index="{{item.index}}"
          bindtap="selectCell"
        >{{item.value}}</button>
      </view>
    </view>

    <view class="clue-list" wx:if="{{visibleEntries.length}}">
      <button
        class="clue-card {{activeEntryId === item.id ? 'active' : ''}}"
        wx:for="{{visibleEntries}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectEntry"
      >
        <text>{{item.direction === 'across' ? '横向' : '纵向'}}</text>
        <text>{{item.clue}}</text>
      </button>
    </view>

    <block wx:if="{{!completed}}">
      <view class="character-bank">
        <button wx:for="{{characterBank}}" wx:key="index" data-value="{{item}}" bindtap="inputCharacter">{{item}}</button>
      </view>

      <view class="game-action-panel">
        <view class="game-tools">
          <button bindtap="eraseCharacter">擦除</button>
          <button loading="{{hinting}}" disabled="{{hintsUsed >= maxHints}}" bindtap="requestHint">提示</button>
        </view>
        <button class="primary-button idiom-submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitPuzzle">提交答案</button>
      </view>
    </block>

    <view class="complete-panel surface" wx:if="{{completed && result}}">
      <view class="complete-mark">✓</view>
      <view class="complete-title">成语挑战完成</view>
      <view class="complete-stars">{{result.stars === 3 ? '★★★' : result.stars === 2 ? '★★☆' : '★☆☆'}}</view>
      <view class="complete-detail">{{result.score}} 分 · {{elapsedText}}</view>
      <button class="primary-button" bindtap="goNext">{{puzzleMode === 'level' && result.next_level_id ? '进入下一关' : '返回关卡目录'}}</button>
    </view>
  </block>
</view>
