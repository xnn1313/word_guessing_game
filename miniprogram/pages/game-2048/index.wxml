<view class="page-shell tile-page">
  <view class="tile-hero">
    <view class="hero-copy">
      <view class="eyebrow">每日方块</view>
      <view class="tile-title">2048</view>
      <view class="tile-subtitle">滑动合并，凑出 2048</view>
    </view>
    <view class="goal-chip">
      <text class="goal-chip-num">2048</text>
      <text class="goal-chip-label">目标</text>
    </view>
  </view>

  <view class="mode-switch">
    <button class="mode-pill {{mode === 'daily' ? 'active' : ''}}" data-value="daily" bindtap="switchMode">每日挑战</button>
    <button class="mode-pill {{mode === 'practice' ? 'active' : ''}}" data-value="practice" bindtap="switchMode">自由练习</button>
  </view>

  <view class="stat-card">
    <view class="stat-item">
      <text class="stat-label">得分</text>
      <text class="stat-value">{{score}}</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-label">最高</text>
      <text class="stat-value">{{bestScore}}</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-label">用时</text>
      <text class="stat-value">{{elapsedText}}</text>
    </view>
  </view>

  <view class="progress">
    <view class="progress-meta">
      <text>合成进度</text>
      <text>{{goalProgress}}%</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{goalProgress}}%"></view>
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">正在铺开棋盘…</view>

  <block wx:else>
    <view class="board" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" catchtouchmove="noop">
      <view class="cell" wx:for="{{cells}}" wx:key="id">
        <view wx:if="{{item.value}}" class="tile {{item.cls}}{{item.spawn ? ' spawn' : ''}}{{item.merge ? ' merge' : ''}}">{{item.value}}</view>
      </view>
    </view>

    <view class="board-footer">
      <text class="board-hint">滑动棋盘 · 相同数字合并</text>
      <button class="ghost-button" bindtap="startGameTap">重新开局</button>
    </view>

    <view class="daily-note">每日挑战使用固定开局，登录后自动保存进度与最高分</view>
  </block>

  <view class="sheet-mask" wx:if="{{(completed || gameOver) && !dismissResult}}" bindtap="closeResult">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-seal {{completed ? 'win' : 'lose'}}">{{completed ? '2048' : '×'}}</view>
      <view class="sheet-title">{{completed ? '达成 2048' : '本局结束'}}</view>
      <view class="sheet-stars" wx:if="{{completed && result}}">{{result.stars === 3 ? '★★★' : result.stars === 2 ? '★★☆' : '★☆☆'}}</view>
      <view class="sheet-score">{{score}}<text class="sheet-unit">分</text></view>
      <view class="sheet-meta">{{moves}} 步 · {{elapsedText}}</view>
      <view class="sheet-note" wx:if="{{submitting}}">正在提交成绩…</view>
      <view class="sheet-actions">
        <button class="cta" wx:if="{{completed}}" bindtap="continuePlay">继续挑战</button>
        <button class="cta" wx:else bindtap="goHub">返回大厅</button>
        <button class="cta-ghost" bindtap="startGameTap">再来一局</button>
      </view>
    </view>
  </view>
</view>
