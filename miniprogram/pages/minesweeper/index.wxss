.mine-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.game-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.mine-seal { display: grid; width: 92rpx; height: 92rpx; flex: 0 0 auto; place-items: center; border: 3rpx solid var(--color-ink); border-radius: 50%; background: var(--color-aqua); box-shadow: 5rpx 5rpx 0 var(--color-ink); color: var(--color-ink); font-size: 40rpx; font-weight: 900; transform: rotate(-4deg); }
.login-gate { margin-top: 40rpx; padding: 40rpx 28rpx 30rpx; text-align: center; }
.gate-icon { display: grid; width: 74rpx; height: 74rpx; margin: 0 auto 16rpx; place-items: center; border: 3rpx solid var(--color-ink); border-radius: 50%; background: var(--color-yellow); font-size: 36rpx; font-weight: 900; }
.gate-title { color: var(--color-ink); font-size: 32rpx; font-weight: 900; }
.gate-note { margin: 8rpx 0 24rpx; color: var(--color-muted); font-size: 21rpx; line-height: 1.55; }
.mode-tabs { margin-top: 22rpx; grid-template-columns: repeat(2,minmax(0,1fr)); }
.mode-tabs button { min-height: 72rpx; font-size: 23rpx; }
.difficulty-tabs { display: grid; margin-top: 12rpx; gap: 8rpx; grid-template-columns: repeat(3,minmax(0,1fr)); }
.difficulty-tabs button { min-height: 62rpx; border: 3rpx solid var(--color-border); border-radius: 13rpx; background: #ffffff; color: var(--color-muted); font-size: 18rpx; font-weight: 800; }
.difficulty-tabs button.active { border-color: var(--color-ink); background: var(--color-yellow); color: var(--color-ink); box-shadow: 3rpx 3rpx 0 var(--color-ink); }
.mine-status { margin-top: 18rpx; }
.mine-board-wrap { position: relative; margin-top: 20rpx; }
.mine-board { display: grid; padding: 10rpx; border: 3rpx solid var(--color-ink); border-radius: 22rpx; background: #6f7bb8; box-shadow: 7rpx 7rpx 0 var(--color-ink); gap: 4rpx; }
.cell { display: grid; aspect-ratio: 1; place-items: center; overflow: hidden; border-radius: 6rpx; background: #8f9bd4; color: var(--color-ink); font-size: 22rpx; font-weight: 900; line-height: 1; user-select: none; }
.cell-revealed { background: #f8f9ff; }
.cell-flagged { background: var(--color-yellow); font-size: 20rpx; }
.cell-mine { background: var(--color-coral); font-size: 20rpx; }
.cell.adj-1 { color: #2342d8; }
.cell.adj-2 { color: #148f80; }
.cell.adj-3 { color: #c63f48; }
.cell.adj-4 { color: #6b3fa0; }
.cell.adj-5 { color: #8a4b1f; }
.cell.adj-6 { color: #0f7a8a; }
.cell.adj-7 { color: var(--color-ink); }
.cell.adj-8 { color: var(--color-subtle); }
.mine-overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: grid; place-items: center; padding: 22rpx; border-radius: 22rpx; background: rgba(21,27,58,.55); }
.overlay-card { width: 100%; max-width: 520rpx; padding: 28rpx 24rpx 22rpx; border: 3rpx solid var(--color-ink); border-radius: 22rpx; background: #fffdf5; box-shadow: 7rpx 7rpx 0 var(--color-ink); text-align: center; }
.overlay-seal { display: grid; width: 70rpx; height: 70rpx; margin: 0 auto 12rpx; place-items: center; border: 3rpx solid var(--color-ink); border-radius: 50%; font-size: 36rpx; font-weight: 900; }
.overlay-seal.won { background: var(--color-aqua); }
.overlay-seal.lost { background: var(--color-coral); color: #ffffff; }
.overlay-title { color: var(--color-ink); font-size: 32rpx; font-weight: 900; }
.overlay-stars { margin-top: 6rpx; color: var(--color-warning); font-size: 36rpx; letter-spacing: 5rpx; }
.overlay-note { margin: 8rpx 0 18rpx; color: var(--color-muted); font-size: 20rpx; line-height: 1.5; }
.overlay-actions { display: grid; gap: 12rpx; grid-template-columns: repeat(2,minmax(0,1fr)); }
.overlay-actions button { min-height: 78rpx; font-size: 22rpx; }
.mine-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 18rpx; }
.mine-hint { color: var(--color-muted); font-size: 20rpx; }
.restart-button { min-height: 66rpx; flex: 0 0 auto; padding: 0 22rpx; border: 3rpx solid var(--color-ink); border-radius: 14rpx; background: var(--color-yellow); box-shadow: 4rpx 4rpx 0 var(--color-ink); color: var(--color-ink); font-size: 21rpx; font-weight: 850; }
.restart-button:active { box-shadow: none; transform: translate(4rpx,4rpx); }
.mine-tips { margin-top: 22rpx; padding: 20rpx 22rpx; border-radius: 20rpx; box-shadow: 5rpx 5rpx 0 var(--color-ink); }
.tip-row { display: flex; align-items: flex-start; gap: 14rpx; color: var(--color-muted); font-size: 20rpx; line-height: 1.55; }
.tip-row + .tip-row { margin-top: 10rpx; padding-top: 10rpx; border-top: 2rpx dashed rgba(21,27,58,.16); }
.tip-index { flex: 0 0 auto; color: var(--color-primary-dark); font-size: 18rpx; font-weight: 900; letter-spacing: 1rpx; }
@media (max-height: 720px) { .page-subtitle { display: none; } .cell { font-size: 19rpx; } .mine-tips { display: none; } }
