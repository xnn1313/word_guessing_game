.auth-page {
  display: flex;
  min-height: calc(100vh - 40rpx);
  justify-content: center;
  flex-direction: column;
}

.auth-intro {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx;
  border: 3rpx solid var(--color-ink);
  border-radius: 28rpx;
  background: var(--color-primary);
  box-shadow: var(--shadow-hard);
  color: #ffffff;
}

.auth-mark {
  display: grid;
  width: 94rpx;
  height: 94rpx;
  flex: 0 0 auto;
  place-items: center;
  border: 3rpx solid var(--color-ink);
  border-radius: 22rpx;
  background: var(--color-yellow);
  color: var(--color-ink);
  font-size: 42rpx;
  font-weight: 900;
  transform: rotate(-4deg);
}

.auth-title { font-size: 34rpx; font-weight: 900; }
.auth-subtitle { margin-top: 7rpx; color: #ffffff; font-size: 22rpx; line-height: 1.5; }

.auth-panel {
  margin-top: 34rpx;
  padding: 28rpx;
  border: 3rpx solid var(--color-ink);
  border-radius: 28rpx;
  background: #ffffff;
}

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding: 6rpx;
  border: 3rpx solid var(--color-ink);
  border-radius: 19rpx;
  background: var(--color-primary-soft);
}

.auth-tab { display: grid; min-height: 88rpx; place-items: center; border-radius: 13rpx; color: var(--color-muted); font-weight: 850; line-height: 1.2; text-align: center; }
.auth-tab.active { background: var(--color-yellow); color: var(--color-ink); box-shadow: 4rpx 4rpx 0 var(--color-ink); }
.field { margin-top: 26rpx; }
.field-label { display: block; margin-bottom: 10rpx; color: var(--color-ink); font-size: 23rpx; font-weight: 850; }
.submit-button { margin-top: 30rpx; }

.auth-footnote {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 28rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.auth-footnote text { width: 12rpx; height: 12rpx; border: 3rpx solid var(--color-ink); border-radius: 50%; background: var(--color-aqua); }

/* ---- 2026 interaction refresh ---- */
page { background: #f6f7fb; }
.auth-page { background: #f6f7fb; }
.auth-mark { border: 0; border-radius: 24rpx; background: #eef0ff; color: #4f5bff; transform: none; }
.auth-title { color: #1b2236; font-size: 42rpx; font-weight: 900; letter-spacing: -1rpx; }
.auth-subtitle { color: #7c8399; }
.auth-panel { border: 0; border-radius: 28rpx; background: #ffffff; box-shadow: 0 12rpx 32rpx rgba(35,42,66,0.06); }
.auth-tabs { padding: 6rpx; border: 0; border-radius: 20rpx; background: #e9ebf3; }
.auth-tab { min-height: 72rpx; border-radius: 15rpx; color: #7c8399; }
.auth-tab.active { background: #ffffff; color: #1b2236; box-shadow: 0 4rpx 12rpx rgba(35,42,66,0.08); }
.field-label { color: #1b2236; }
.auth-page .text-input { border: 2rpx solid #e9ecf3; border-radius: 16rpx; background: #f9fafc; }
.auth-page .primary-button { border: 0; border-radius: 18rpx; background: #1b2236; box-shadow: none; color: #ffffff; }
.auth-footnote { color: #9299b0; }
