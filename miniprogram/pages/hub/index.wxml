<view class="hub-page">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="hub-nav" style="height: {{navHeight}}px;">
    <text class="hub-date">{{dateText}}</text>
    <view class="hub-account" bindtap="openProfile">
      <text>{{avatarText}}</text>
    </view>
  </view>

  <view class="hub-hero">
    <view class="hub-hero-copy">
      <text class="hub-kicker">{{tab === 'today' ? 'TODAY' : 'TRAIL'}}</text>
      <view class="hub-title">{{tab === 'today' ? '今日任务' : '闯关'}}</view>
      <view class="hub-sub">{{tab === 'today' ? '十款小游戏，今天挑几项练练' : '挑一条路线，接着上次往前推'}}</view>
    </view>
    <view class="hero-stars">
      <text class="hero-stars-value">{{totalStars}}</text>
      <text class="hero-stars-label">总星数</text>
    </view>
  </view>

  <view class="seg">
    <view class="seg-item {{tab === 'today' ? 'on' : ''}}" data-tab="today" bindtap="switchTab">今日任务</view>
    <view class="seg-item {{tab === 'trail' ? 'on' : ''}}" data-tab="trail" bindtap="switchTab">闯关</view>
  </view>

  <block wx:if="{{tab === 'today'}}">
    <view class="summary-card">
      <view class="summary-top">
        <text class="summary-title">已完成 {{completedToday}} / {{dailyTotal}}</text>
        <text class="summary-star">+{{totalStars}} ★</text>
      </view>
      <view class="track">
        <view class="track-fill" style="width: {{dailyTotal ? completedToday / dailyTotal * 100 : 0}}%;"></view>
      </view>
      <view class="summary-meta">
        <text>每天一页，做完就收工</text>
        <text>{{dailyTotal > completedToday ? dailyTotal - completedToday : 0}} 项待完成</text>
      </view>
    </view>

    <view class="loading-line" wx:if="{{loading}}">正在整理今天的任务…</view>

    <view class="task-list">
      <view
        class="task {{item.completed ? 'done' : ''}} {{item.available ? '' : 'offline'}}"
        wx:for="{{tasks}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="openTask"
        hover-class="row-pressed"
      >
        <view class="task-icon tone-{{item.tone}}">{{item.icon}}</view>
        <view class="task-main">
          <text class="task-title">{{item.title}}</text>
          <text class="task-sub">{{item.progressText}}</text>
        </view>
        <view class="task-side">
          <view class="check" wx:if="{{item.completed}}">✓</view>
          <view class="go" wx:elif="{{item.started}}">继续</view>
          <text class="task-state" wx:else>开始</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="summary-card">
      <view class="summary-top">
        <text class="summary-title">闯关路线</text>
        <text class="summary-star">{{totalStars}} ★</text>
      </view>
      <view class="track">
        <view class="track-fill indigo" style="width: {{trailPercent}}%;"></view>
      </view>
      <view class="summary-meta">
        <text>四段路线，进度各自独立</text>
        <text>慢慢来</text>
      </view>
    </view>

    <view class="trail-list">
      <view
        class="trail"
        wx:for="{{trails}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="openTrail"
        hover-class="row-pressed"
      >
        <view class="trail-icon tone-{{item.tone}}">{{item.icon}}</view>
        <view class="trail-main">
          <text class="trail-title">{{item.trailTitle}}</text>
          <text class="trail-sub">{{item.progressText}}</text>
          <view class="trail-bar">
            <view style="width: {{item.percent}}%;"></view>
          </view>
        </view>
        <view class="trail-side">
          <text>{{item.percent}}%</text>
          <text class="trail-arrow">→</text>
        </view>
      </view>
    </view>
  </block>

  <view class="continue-bar" wx:if="{{lastTask && tab === 'today'}}" bindtap="openContinue" hover-class="row-pressed">
    <view class="continue-icon tone-{{lastTask.tone}}">{{lastTask.icon}}</view>
    <view class="continue-main">
      <text class="continue-title">继续 · {{lastTask.title}}</text>
      <text class="continue-sub">{{lastTask.progressText}}</text>
    </view>
    <text class="continue-arrow">→</text>
  </view>

  <view class="app-tabbar hub-tabbar">
    <view class="app-tab-item active"><view class="nav-icon nav-games"></view><text>游戏</text></view>
    <view class="app-tab-item" bindtap="openRecords" hover-class="nav-pressed"><view class="nav-icon nav-records"></view><text>记录</text></view>
    <view class="app-tab-item" bindtap="openProfile" hover-class="nav-pressed"><view class="nav-icon nav-profile"></view><text>我的</text></view>
  </view>
</view>
