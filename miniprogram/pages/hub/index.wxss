page {
  background: #f6f7fb;
  color: #1b2236;
}

.hub-page {
  min-height: 100vh;
  padding: 0 32rpx calc(220rpx + env(safe-area-inset-bottom));
  background: #f6f7fb;
}

.hub-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 170rpx;
}

.hub-date {
  color: #7c8399;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hub-account {
  display: none;
}

.hub-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 10rpx;
}

.hub-hero-copy {
  min-width: 0;
}

.hub-kicker {
  display: block;
  color: #9aa1b4;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hub-title {
  margin-top: 10rpx;
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: -3rpx;
  line-height: 1.05;
}

.hub-sub {
  margin-top: 10rpx;
  color: #7c8399;
  font-size: 23rpx;
}

.hero-stars {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  padding-bottom: 6rpx;
  flex-direction: column;
}

.hero-stars-value {
  color: #4f5bff;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-stars-label {
  margin-top: 6rpx;
  color: #9299b0;
  font-size: 19rpx;
}

.seg {
  display: grid;
  margin-top: 26rpx;
  padding: 6rpx;
  border-radius: 26rpx;
  background: #e9ebf3;
  grid-template-columns: 1fr 1fr;
}

.seg-item {
  padding: 18rpx 0;
  border-radius: 21rpx;
  color: #7c8399;
  font-size: 25rpx;
  font-weight: 800;
  text-align: center;
  transition: background 180ms ease, color 180ms ease;
}

.seg-item.on {
  background: #ffffff;
  color: #1b2236;
  box-shadow: 0 6rpx 18rpx rgba(35, 42, 66, 0.08);
}

.summary-card {
  margin-top: 18rpx;
  padding: 26rpx 26rpx 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(35, 42, 66, 0.05);
}

.summary-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.summary-title {
  font-size: 27rpx;
  font-weight: 800;
}

.summary-star {
  color: #f0a92c;
  font-size: 24rpx;
  font-weight: 900;
}

.track {
  height: 12rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 99rpx;
  background: #eef0f6;
}

.track-fill {
  height: 100%;
  border-radius: 99rpx;
  background: linear-gradient(90deg, #6b7bff, #4f5bff);
  transition: width 300ms ease;
}

.track-fill.indigo {
  background: linear-gradient(90deg, #8b95ff, #4f5bff);
}

.summary-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #9299b0;
  font-size: 19rpx;
}

.task-list {
  display: flex;
  margin-top: 18rpx;
  flex-direction: column;
  gap: 14rpx;
}

.task {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(35, 42, 66, 0.04);
  transition: transform 140ms ease, opacity 140ms ease;
}

.task.done {
  background: rgba(18, 183, 106, 0.055);
}

.task.offline {
  opacity: 0.55;
}

.task-icon,
.trail-icon,
.continue-icon {
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 20rpx;
  font-weight: 900;
}

.task-icon {
  width: 76rpx;
  height: 76rpx;
  font-size: 23rpx;
}

.tone-amber { background: #fff1d6; color: #a06400; }
.tone-blue { background: #e7ecff; color: #3b52d9; }
.tone-pink { background: #ffe7ef; color: #c23a67; }
.tone-violet { background: #efeaff; color: #6b4fd8; }
.tone-cyan { background: #e0f7f4; color: #0d8a7c; }
.tone-gold { background: #fff4cf; color: #9a6a00; }
.tone-green { background: #e5f6e8; color: #2f7d3f; }
.tone-indigo { background: #eaeaff; color: #4f5bff; }
.tone-mint { background: #e3f6f1; color: #12836f; }

.task-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.task-title {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task.done .task-title {
  color: #7c8399;
  text-decoration: line-through;
}

.task-sub {
  margin-top: 6rpx;
  overflow: hidden;
  color: #9299b0;
  font-size: 20rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-side {
  flex: 0 0 auto;
}

.check {
  display: grid;
  width: 46rpx;
  height: 46rpx;
  place-items: center;
  border-radius: 50%;
  background: #12b76a;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.go {
  padding: 10rpx 18rpx;
  border-radius: 99rpx;
  background: #1b2236;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 800;
}

.task-state {
  color: #9299b0;
  font-size: 19rpx;
  font-weight: 700;
}

.loading-line {
  margin-top: 20rpx;
  color: #9299b0;
  font-size: 21rpx;
  text-align: center;
}

.trail-list {
  display: flex;
  margin-top: 18rpx;
  flex-direction: column;
  gap: 14rpx;
}

.trail {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(35, 42, 66, 0.04);
}

.trail-icon {
  width: 82rpx;
  height: 82rpx;
  font-size: 24rpx;
}

.trail-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.trail-title {
  font-size: 27rpx;
  font-weight: 800;
}

.trail-sub {
  margin-top: 5rpx;
  color: #9299b0;
  font-size: 19rpx;
}

.trail-bar {
  height: 8rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 99rpx;
  background: #eef0f6;
}

.trail-bar view {
  height: 100%;
  border-radius: 99rpx;
  background: #4f5bff;
}

.trail-side {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  flex-direction: column;
  gap: 8rpx;
  color: #9299b0;
  font-size: 18rpx;
}

.trail-arrow {
  color: #1b2236;
  font-size: 24rpx;
}

.continue-bar {
  position: fixed;
  z-index: 20;
  right: 24rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 28rpx;
  background: #1b2236;
  box-shadow: 0 18rpx 40rpx rgba(27, 34, 54, 0.28);
  color: #ffffff;
}

.continue-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
}

.continue-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.continue-title {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continue-sub {
  margin-top: 3rpx;
  overflow: hidden;
  color: #9aa2b6;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continue-arrow {
  flex: 0 0 auto;
  font-size: 26rpx;
}

.hub-tabbar {
  border: 0;
  border-radius: 34rpx 34rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(35, 42, 66, 0.08);
}

.hub-tabbar .app-tab-item.active {
  background: #eef0ff;
  color: #4f5bff;
}

.row-pressed {
  opacity: 0.92;
  transform: scale(0.995);
}

@media (max-height: 700px) {
  .hub-title { font-size: 56rpx; }
  .hub-sub { display: none; }
}
