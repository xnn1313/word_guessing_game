.category-stars { flex: 0 0 auto; color: #4f5bff; font-size: 19rpx; font-weight: 800; }
.category-right { display: none; }
.category-chevron { width: 44rpx; height: 44rpx; border: 0; border-radius: 50%; background: #f2f4fa; color: #7c8399; font-size: 24rpx; text-align: center; line-height: 44rpx; }
.level-area { padding: 18rpx 20rpx 22rpx; background: #fbfcff; }
.difficulty-line { display: none; }
.level-grid { gap: 10rpx; }
.level-button { min-height: 104rpx; padding: 10rpx 4rpx; border: 2rpx solid #e9ecf3; border-radius: 18rpx; background: #ffffff; }
.level-number { color: #1b2236; font-size: 27rpx; font-weight: 900; }
.level-stars { margin-top: 3rpx; color: #c9cedd; font-size: 15rpx; letter-spacing: 1rpx; }
.level-label { margin-top: 3rpx; color: #9299b0; font-size: 15rpx; }
.level-button.locked { border-color: #f1f3f8; background: #f5f6fa; }
.level-button.locked text { color: #b3b9c9; }
.level-button.current { border-color: #1b2236; box-shadow: 0 0 0 2rpx #1b2236; }
.level-button.current .level-number { color: #1b2236; }
.level-button.difficulty-easy:not(.locked),
.level-button.difficulty-medium:not(.locked),
.level-button.difficulty-hard:not(.locked) { border-top: 2rpx solid #e9ecf3; }
