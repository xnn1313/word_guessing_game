.progress-track { height: 12rpx; margin-top: 18rpx; border: 0; border-radius: 99rpx; background: #eef0f6; }
.progress-fill { min-width: 4rpx; height: 100%; border-radius: 99rpx; background: linear-gradient(90deg,#6b7bff,#4f5bff); }
.progress-note { margin-top: 12rpx; color: #9299b0; font-size: 18rpx; }
.category-list { gap: 16rpx; margin-top: 22rpx; }
.category { overflow: hidden; border: 0; border-radius: 26rpx; background: #ffffff; box-shadow: 0 6rpx 20rpx rgba(35,42,66,0.04); }
.category-header { min-height: 132rpx; gap: 18rpx; padding: 20rpx; }
.category-header.expanded { border-bottom: 0; background: #ffffff; }
.category-emoji { width: 72rpx; height: 72rpx; border: 0; border-radius: 20rpx; background: #fff1d6; font-size: 34rpx; }
.category-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.category-name { font-size: 28rpx; font-weight: 800; }
.category-description { margin-top: 4rpx; color: #9299b0; font-size: 19rpx; }
